// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum GenerationStage {
  LEDGER
  NARRATIVE_ANALYSIS
  OUTLINE
  STORY
  VALIDATION
  REPAIR
  SCENE_BREAKDOWN
}

enum SagaVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CreditLedgerEntryType {
  INTRODUCTORY_GRANT
  ONE_TIME_PURCHASE
  SUBSCRIPTION_GRANT
  GENERATION_CONSUMPTION
  GENERATION_REFUND
  PURCHASE_REFUND
  ADMINISTRATIVE_ADJUSTMENT
}

enum CreditReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum BillingPlan {
  SCRIBE
  CHRONICLER
  REALM_FOUNDER
}

enum GenerationBillingState {
  UNTRACKED
  AUTHORIZING
  SHADOW_ANONYMOUS
  SHADOW_UNLIMITED
  SHADOW_AVAILABLE
  SHADOW_INSUFFICIENT
  RESERVED
  UNLIMITED
  REUSED
  CONSUMED
  RELEASED
}

enum AiCallStatus {
  SUCCEEDED
  FAILED
}

model Game {
  id             String             @id @default(cuid())
  ownerId        String?
  pgnHash        String
  rawPgn         String             @db.Text
  whitePlayer    String
  blackPlayer    String
  result         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  ledger         GameLedger?
  generationRuns GenerationRun[]
  sagaJob        SagaGenerationJob?
  sagas          Saga[]
  aiCalls        AiCall[]
  owner          User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([pgnHash])
}

model User {
  id                    String                @id @default(cuid())
  googleSub             String?               @unique
  appleSub              String?               @unique
  email                 String                @unique
  displayName           String
  avatarUrl             String?
  stripeCustomerId      String?               @unique
  termsAcceptedAt       DateTime?
  termsVersion          String?
  privacyAcknowledgedAt DateTime?
  privacyVersion        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              AuthSession[]
  games                 Game[]
  publicProfile         PublicProfile?
  sagas                 Saga[]                @relation("SagaCreator")
  sagaBookmarks         SagaBookmark[]
  creditEntries         CreditLedgerEntry[]
  creditReservations    CreditReservation[]
  billingSubscriptions  BillingSubscription[]
  requestedSagaJobs     SagaGenerationJob[]   @relation("SagaJobRequester")
}

model PublicProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  handle            String   @unique
  displayName       String
  avatarUrl         String?
  bio               String?  @db.VarChar(500)
  showCreatorCredit Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SagaGenerationJob {
  id                 String                 @id @default(cuid())
  gameId             String                 @unique
  status             GenerationStatus       @default(QUEUED)
  currentStage       GenerationStage        @default(NARRATIVE_ANALYSIS)
  error              String?                @db.Text
  workerId           String?
  lockedUntil        DateTime?
  heartbeatAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  completedAt        DateTime?
  pushSubscriptions  Json?
  requestedByUserId  String?
  requestIpHash      String?
  billingState       GenerationBillingState @default(UNTRACKED)
  game               Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  requestedBy        User?                  @relation("SagaJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  creditReservations CreditReservation[]

  @@index([status, lockedUntil])
  @@index([requestedByUserId, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([billingState, updatedAt])
}

model GameLedger {
  id            String   @id @default(cuid())
  gameId        String   @unique
  schemaVersion Int      @default(1)
  initialFen    String
  finalFen      String
  data          Json
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GenerationRun {
  id                String             @id @default(cuid())
  gameId            String
  status            GenerationStatus   @default(QUEUED)
  currentStage      GenerationStage    @default(LEDGER)
  model             String?
  promptVersion     String?
  options           Json?
  error             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?
  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  narrativeAnalysis NarrativeAnalysis?
  storyOutline      StoryOutline?
  generatedStory    GeneratedStory?
  storyValidation   StoryValidation?
  sceneBreakdown    SceneBreakdown?
  saga              Saga?
  aiCalls           AiCall[]

  @@index([gameId, createdAt])
  @@index([status, createdAt])
}

model AiCall {
  id                  String        @id @default(cuid())
  gameId              String
  generationRunId     String
  stage               String
  model               String
  status              AiCallStatus
  attempt             Int           @default(1)
  repairMode          String?
  durationMs          Int
  payloadBytes        Int
  inputTokens         Int
  cachedInputTokens   Int
  cacheWriteTokens    Int
  reasoningTokens     Int
  outputTokens        Int
  estimatedCostMicros Int
  error               String?       @db.Text
  createdAt           DateTime      @default(now())
  game                Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  generationRun       GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([gameId, createdAt])
  @@index([generationRunId])
  @@index([stage, model, status, createdAt])
}

model Saga {
  id              String         @id @default(cuid())
  gameId          String
  generationRunId String         @unique
  creatorId       String?
  visibility      SagaVisibility @default(PUBLIC)
  storyVersion    String?
  parentSagaId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  game            Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  generationRun   GenerationRun  @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  creator         User?          @relation("SagaCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parentSaga      Saga?          @relation("AlternateTellings", fields: [parentSagaId], references: [id], onDelete: SetNull)
  alternateSagas  Saga[]         @relation("AlternateTellings")
  bookmarks       SagaBookmark[]

  @@index([visibility, createdAt])
  @@index([creatorId, createdAt])
  @@index([gameId, createdAt])
  @@index([parentSagaId])
}

model SagaBookmark {
  userId    String
  sagaId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saga      Saga     @relation(fields: [sagaId], references: [id], onDelete: Cascade)

  @@id([userId, sagaId])
  @@index([sagaId])
  @@index([userId, createdAt])
}

model CreditLedgerEntry {
  id             String                @id @default(cuid())
  userId         String
  amount         Int
  type           CreditLedgerEntryType
  idempotencyKey String                @unique
  stripeEventId  String?
  referenceId    String?
  description    String?               @db.VarChar(500)
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeEvent    StripeEvent?          @relation(fields: [stripeEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([referenceId])
  @@index([stripeEventId])
  @@index([userId, expiresAt])
}

model CreditReservation {
  id                  String                  @id @default(cuid())
  userId              String
  sagaGenerationJobId String?                 @unique
  amount              Int                     @default(1)
  status              CreditReservationStatus @default(ACTIVE)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  resolvedAt          DateTime?
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sagaGenerationJob   SagaGenerationJob?      @relation(fields: [sagaGenerationJobId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model StripeEvent {
  id              String              @id
  type            String
  objectId        String?
  livemode        Boolean
  apiVersion      String?
  payload         Json?
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  processingError String?             @db.Text
  creditEntries   CreditLedgerEntry[]

  @@index([type, receivedAt])
  @@index([objectId])
  @@index([processedAt])
}

model BillingSubscription {
  id                 String      @id
  userId             String
  plan               BillingPlan
  priceId            String
  status             String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([priceId])
}

model SceneBreakdown {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model StoryValidation {
  id                    String        @id @default(cuid())
  generationRunId       String        @unique
  sourceStoryId         String
  schemaVersion         Int           @default(1)
  valid                 Boolean
  findings              Json
  repairedStoryMarkdown String?       @db.Text
  createdAt             DateTime      @default(now())
  generationRun         GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GeneratedStory {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  title           String
  titleKey        String?       @unique
  storyMarkdown   String        @db.Text
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model StoryOutline {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model NarrativeAnalysis {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}
