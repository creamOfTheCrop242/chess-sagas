# Local development only. Heroku supplies production values through Config Vars.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
NARRATIVE_ANALYSIS_MODEL="gpt-5.6-sol"
STORY_OUTLINE_MODEL="gpt-5.6-sol"
FULL_STORY_MODEL="gpt-5.6-sol"

# Optional. Heroku sets PORT automatically.
PORT=3000
