# Local development only. Heroku supplies production values through Config Vars.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
PUBLIC_APP_URL="http://localhost:4200"
APPLE_CLIENT_ID="com.example.chesssagas.web"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL="https://chesssagas.com/api/auth/apple/callback"
NARRATIVE_ANALYSIS_MODEL="gpt-5.6-luna"
STORY_OUTLINE_MODEL="gpt-5.6-luna"
FULL_STORY_MODEL="gpt-5.6-terra"
WOUND_SCENE_REPAIR_MODEL="gpt-5.6-luna"
STORY_VALIDATION_MODEL="gpt-5.6-sol"
SCENE_BREAKDOWN_MODEL="gpt-5.6-sol"

# Optional. Heroku sets PORT automatically.
PORT=3000
