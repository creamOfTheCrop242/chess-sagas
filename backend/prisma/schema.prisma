// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum GenerationStage {
  LEDGER
  NARRATIVE_ANALYSIS
  OUTLINE
  STORY
  VALIDATION
  REPAIR
  SCENE_BREAKDOWN
}

model Game {
  id             String             @id @default(cuid())
  ownerId        String?
  pgnHash        String
  rawPgn         String             @db.Text
  whitePlayer    String
  blackPlayer    String
  result         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  ledger         GameLedger?
  generationRuns GenerationRun[]
  sagaJob        SagaGenerationJob?

  @@index([ownerId, createdAt])
  @@index([pgnHash])
}

model SagaGenerationJob {
  id           String           @id @default(cuid())
  gameId       String           @unique
  status       GenerationStatus @default(QUEUED)
  currentStage GenerationStage  @default(NARRATIVE_ANALYSIS)
  error        String?          @db.Text
  workerId     String?
  lockedUntil  DateTime?
  heartbeatAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  completedAt  DateTime?
  game         Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([status, lockedUntil])
}

model GameLedger {
  id            String   @id @default(cuid())
  gameId        String   @unique
  schemaVersion Int      @default(1)
  initialFen    String
  finalFen      String
  data          Json
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GenerationRun {
  id                String             @id @default(cuid())
  gameId            String
  status            GenerationStatus   @default(QUEUED)
  currentStage      GenerationStage    @default(LEDGER)
  model             String?
  promptVersion     String?
  options           Json?
  error             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?
  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  narrativeAnalysis NarrativeAnalysis?
  storyOutline      StoryOutline?
  generatedStory    GeneratedStory?
  storyValidation   StoryValidation?
  sceneBreakdown    SceneBreakdown?

  @@index([gameId, createdAt])
  @@index([status, createdAt])
}

model SceneBreakdown {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model StoryValidation {
  id                    String        @id @default(cuid())
  generationRunId       String        @unique
  sourceStoryId         String
  schemaVersion         Int           @default(1)
  valid                 Boolean
  findings              Json
  repairedStoryMarkdown String?       @db.Text
  createdAt             DateTime      @default(now())
  generationRun         GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model GeneratedStory {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  title           String
  storyMarkdown   String        @db.Text
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model StoryOutline {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}

model NarrativeAnalysis {
  id              String        @id @default(cuid())
  generationRunId String        @unique
  schemaVersion   Int           @default(1)
  data            Json
  createdAt       DateTime      @default(now())
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
}
